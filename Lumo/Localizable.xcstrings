    "If you love the game, you can buy the developer a coffee ☕️": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dir das Spiel gefällt, kannst du dem Entwickler einen Kaffee spendieren ☕️"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si te gusta el juego, puedes invitar a un café al desarrollador ☕️"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu aimes le jeu, tu peux offrir un café au développeur ☕️"
