    "No purchase gives a gameplay advantage. There is no pay-to-win in LUMO.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Kauf verschafft einen Spielvorteil. In LUMO gibt es kein Pay-to-Win."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna compra da ventaja en el juego. En LUMO no hay pay-to-win."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun achat ne donne d'avantage en jeu. Pas de pay-to-win dans LUMO."
          }
        },
        "ja": {
