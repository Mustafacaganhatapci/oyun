    "Ad closed early — no extra life this time": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werbung zu früh geschlossen – diesmal kein Extraleben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuncio cerrado antes de tiempo — esta vez sin vida extra"
