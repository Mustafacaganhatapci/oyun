    "Hop as often as you like. There's no limit and no hurry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hop as often as you like. There's no limit and no hurry"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğin kadar atla. Sınır da yok, acele de yok"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spring so oft du willst. Kein Limit, keine Eile"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta tantas veces como quieras. Ni límite ni prisa"
