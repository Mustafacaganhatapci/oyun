    "Premium is coming soon to the App Store. Have a code? Enter it below.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium is coming soon to the App Store. Have a code? Enter it below."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium çok yakında App Store'da. Kodun mu var? Aşağıya gir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium kommt bald in den App Store. Hast du einen Code? Gib ihn unten ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium llegará pronto al App Store. ¿Tienes un código? Introdúcelo abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium arrive bientôt sur l'App Store. Un code ? Saisis-le ci-dessous."
