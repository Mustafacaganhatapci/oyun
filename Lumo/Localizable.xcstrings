    "Both go on the weekly board, and it resets every Monday. See if you can take a place in the top three." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide zählen für die Wochenrangliste, die jeden Montag zurückgesetzt wird. Mal sehen, ob du es in die Top 3 schaffst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both go on the weekly board, and it resets every Monday. See if you can take a place in the top three."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dos entran en la tabla semanal, que se reinicia cada lunes. A ver si logras entrar en el top 3."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux comptent pour le classement hebdomadaire, remis à zéro chaque lundi. On verra si tu entres dans le top 3."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらも週間ランキングに載り、毎週月曜にリセットされます。トップ3に入れるか試してみてください。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İkisi de haftalık tabloya yazılıyor, tablo her pazartesi sıfırlanıyor. Bakalım ilk üçe girebilecek misin."
          }
        }
      }
    },
