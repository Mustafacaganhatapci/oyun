    },
    "This is the name shown on the world ranking. It is chosen once and cannot be changed later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Name erscheint in der Weltrangliste. Er wird einmal gewählt und kann später nicht geändert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es el nombre que aparece en la clasificación mundial. Se elige una vez y no se puede cambiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est le nom affiché dans le classement mondial. Il est choisi une seule fois et ne peut plus être modifié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界ランキングに表示される名前です。一度だけ設定でき、あとから変更はできません。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dünya sıralamasında görünecek ad budur. Bir kez seçilir, sonradan değiştirilemez."
          }
        }
      }
    },
    "This level is timed! Reach the gate before the countdown hits zero.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Level ist auf Zeit! Erreiche das Tor, bevor der Countdown abläuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Este nivel es contrarreloj! Llega a la puerta antes de que el contador llegue a cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce niveau est chronométré ! Atteignez le portail avant la fin du compte à rebours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この面は時間制限あり！カウントがゼロになる前にゲートへ。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bölüm süreli! Geri sayım sıfırlanmadan kapıya ulaş."
          }
        }
      }
    },
    "This ring drifts — time your jump!": {
      "extractionState": "manual",
      "localizations": {
