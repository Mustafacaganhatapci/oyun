    "Add Firebase to enable the world ranking (see README). Your local best is shown below.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Firebase hinzu, um die Weltrangliste zu aktivieren (siehe README). Deine lokale Bestleistung steht unten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade Firebase para activar la clasificación mundial (ver README). Tu mejor marca local está abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute Firebase pour activer le classement mondial (voir README). Ton meilleur score local est ci-dessous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界ランキングにはFirebaseを追加してください（README参照）。下にローカルベストを表示。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dünya sıralaması için Firebase ekle (README'ye bak). Yerel en iyin aşağıda."
          }
        }
      }
    },
    "Ads keep Orbeon free. If you're enjoying it, you can buy the developer a coffee ☕️": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ads keep Orbeon free. If you're enjoying it, you can buy the developer a coffee ☕️"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklamlar Orbeon'u ücretsiz tutuyor. Beğendiysen geliştiriciye bir kahve ısmarlayabilirsin ☕️"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werbung hält Orbeon kostenlos. Wenn es dir gefällt, spendier dem Entwickler einen Kaffee ☕️"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los anuncios mantienen Orbeon gratis. Si te gusta, invita un café al desarrollador ☕️"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pubs gardent Orbeon gratuit. Si tu l'aimes, offre un café au développeur ☕️"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告のおかげでOrbeonは無料です。気に入ったら開発者にコーヒーをどうぞ ☕️"
          }
        }
      }
    },
