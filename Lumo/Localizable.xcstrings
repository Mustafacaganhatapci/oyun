    "Go Premium to remove all ads forever, unlock 8 exclusive themes and put your own photo in the orb.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go Premium to remove all ads forever, unlock 8 exclusive themes and put your own photo in the orb."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium ile tüm reklamları sonsuza dek kaldır, 8 özel temayı aç ve kürenin içine kendi fotoğrafını koy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hol dir Premium: alle Werbung für immer weg, 8 exklusive Themes und dein eigenes Foto in der Kugel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazte Premium para quitar todos los anuncios para siempre, desbloquear 8 temas exclusivos y poner tu foto en el orbe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe à Premium pour supprimer toutes les pubs à jamais, débloquer 8 thèmes exclusifs et mettre ta photo dans l'orbe."
