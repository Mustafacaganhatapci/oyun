    },
    "All music and sounds are synthesized in real time on your device.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Musik und Sounds werden in Echtzeit auf deinem Gerät erzeugt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda la música y los sonidos se sintetizan en tiempo real en tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute la musique et les sons sont synthétisés en temps réel sur ton appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての音楽とサウンドは端末上でリアルタイムに合成されます。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm müzik ve sesler cihazında gerçek zamanlı sentezlenir."
          }
        }
      }
    },
