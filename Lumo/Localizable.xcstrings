    "Hold to slow time" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte gedrückt, die Zeit wird langsamer"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold to slow time"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado para ralentizar el tiempo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintiens pour ralentir le temps"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長押しで時間が遅くなる"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basılı tut, zaman yavaşlasın"
          }
        }
      }
    },
    "Hold to slow time. The line shows where you land." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte gedrückt, um die Zeit zu verlangsamen. Die Linie zeigt, wo du landest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado para ralentizar el tiempo. La línea muestra dónde caerás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintiens pour ralentir le temps. La ligne montre où tu vas atterrir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長押しで時間がゆっくりに。線が着地点を示します。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basılı tut, zaman yavaşlasın. Çizgi nereye ineceğini gösterir."
          }
        }
      }
    },
    "Hold your finger down and time slows to a crawl. Let go and the orb launches. The ring around the orb is your meter: it drains while you hold and refills while you wait." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den Finger gedrückt und die Zeit wird zäh. Lässt du los, startet die Kugel. Der Bogen um die Kugel ist deine Anzeige: Er leert sich beim Halten und füllt sich beim Warten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold your finger down and time slows to a crawl. Let go and the orb launches. The ring around the orb is your meter: it drains while you hold and refills while you wait."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el dedo pulsado y el tiempo se ralentiza. Al soltar, la esfera sale disparada. El arco alrededor de la esfera es tu medidor: se vacía mientras mantienes y se llena mientras esperas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde le doigt appuyé et le temps ralentit. Relâche et la sphère part. L’arc autour de la sphère est ta jauge : elle se vide quand tu maintiens et se remplit quand tu attends."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指を押したままにすると時間がゆっくりになります。離すとオーブが飛びます。オーブの周りの弧がゲージ：押している間は減り、待っている間に回復します。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parmağını basılı tut, zaman ağırlaşsın. Bırakınca küre fırlar. Kürenin çevresindeki yay senin göstergen: basılı tuttukça tükeniyor, beklerken doluyor."
          }
        }
      }
    },
    "Hop" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
