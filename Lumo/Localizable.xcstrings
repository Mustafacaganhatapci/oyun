    "You played for this one. The ads are off for good, and not a single star was spent — every one of them is still yours." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das hier hast du dir erspielt. Die Werbung ist für immer weg, und kein einziger Stern wurde abgezogen — sie gehören alle noch dir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este te lo has jugado. La publicidad se acabó para siempre, y no se gastó ni una estrella: todas siguen siendo tuyas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celui-là, tu l'as joué. Fini la publicité, définitivement, et pas une seule étoile n'a été dépensée : elles sont toutes encore à toi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは自分で勝ち取ったものです。広告はこれきりで消え、星は一つも減っていません——すべてそのまま残ります。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
