    "New levels, new characters and a nudge before the weekly board resets. Nothing else.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New levels, new characters and a nudge before the weekly board resets. Nothing else."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bölümler, yeni karakterler ve haftalık tablo sıfırlanmadan önce bir hatırlatma. Başka bir şey değil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Level, neue Charaktere und eine Erinnerung, bevor die Wochentabelle zurückgesetzt wird. Sonst nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveles nuevos, personajes nuevos y un aviso antes de que se reinicie la tabla semanal. Nada más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouveaux niveaux, nouveaux personnages et un rappel avant la remise à zéro du classement. Rien d'autre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいレベル、新しいキャラクター、週間ランキングのリセット前のお知らせ。それだけです。"
          }
        }
      }
    },
