    "4 exclusive themes: Dawn, Forest, Coral, Aurora": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "4 exklusive Themes: Morgenrot, Wald, Koralle, Aurora"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "4 temas exclusivos: Alba, Bosque, Coral, Aurora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "4 thèmes exclusifs : Aube, Forêt, Corail, Aurore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "限定テーマ4種：夜明け、森、サンゴ、オーロラ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
