    "The orb orbits a ring. Tap anywhere to launch it toward the next ring.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kugel umkreist einen Ring. Tippe irgendwo, um sie zum nächsten Ring zu schleudern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El orbe gira alrededor de un anillo. Toca en cualquier parte para lanzarlo al siguiente anillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'orbe tourne autour d'un anneau. Touchez n'importe où pour le lancer vers l'anneau suivant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーブはリングの周りを回ります。どこかをタップして次のリングへ飛ばそう。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küre bir halkanın çevresinde döner. Bir sonraki halkaya fırlatmak için herhangi bir yere dokun."
          }
        }
      }
    },
