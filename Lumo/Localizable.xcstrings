        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そこに届いた時点でプレミアムが自動で解放されます。消費はありません——星はすべて手元に残ります。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oraya vardığında Premium kendiliğinden açılıyor. Hiçbir şey harcanmıyor — yıldızların tamamı sende kalıyor."
          }
        }
      }
    },
