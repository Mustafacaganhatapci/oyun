        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyunu sevdiysen geliştiriciye bir kahve ısmarlayabilirsin ☕️"
          }
        }
      }
    },
    "In the real version an interstitial ad is shown here.\nPremium removes all ads.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der echten Version wird hier eine Werbeanzeige gezeigt.\nPremium entfernt alle Werbung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la versión real aquí se muestra un anuncio.\nPremium elimina todos los anuncios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la version finale, une pub s'affiche ici.\nPremium supprime toutes les pubs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "製品版ではここに広告が表示されます。\nプレミアムで全広告が消えます。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçek sürümde burada geçiş reklamı gösterilir.\nPremium ile tüm reklamlar kalkar."
          }
        }
      }
    },
