    },
    "No gate and nothing that can hurt you here. Just grab as many stars as you can before the clock runs out.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No gate and nothing that can hurt you here. Just grab as many stars as you can before the clock runs out."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada kapı da yok, sana zarar verecek bir şey de. Süre dolmadan toplayabildiğin kadar yıldız topla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier gibt es kein Tor und nichts, was dir schaden kann. Sammle einfach so viele Sterne wie möglich, bevor die Zeit abläuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no hay puerta ni nada que pueda hacerte daño. Solo recoge todas las estrellas que puedas antes de que se acabe el tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ici, pas de porte et rien qui puisse te blesser. Ramasse simplement le plus d'étoiles possible avant la fin du temps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにはゲートも、あなたを傷つけるものもありません。時間切れまでに星をできるだけ集めてください。"
          }
        }
      }
    },
    "No previous purchases found on this Apple Account": {
