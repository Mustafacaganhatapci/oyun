    "Some rings drift back and forth. Wait for the right moment.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Ringe bewegen sich hin und her. Warte auf den richtigen Moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos anillos se mueven de un lado a otro. Espera el momento justo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains anneaux vont et viennent. Attendez le bon moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リングの中には左右に動くものもあります。タイミングを待とう。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı halkalar ileri geri hareket eder. Doğru anı bekle."
          }
        }
      }
    },
    "Something broken, something missing, an idea? Write it here and it comes straight to me.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something broken, something missing, an idea? Write it here and it comes straight to me."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bozuk bir şey mi var, eksik mi buldun, aklına bir fikir mi geldi? Buraya yaz, doğrudan bana ulaşıyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas kaputt, etwas fehlt, eine Idee? Schreib es hier hin, es kommt direkt bei mir an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Algo roto, algo que falta, una idea? Escríbelo aquí y me llega directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bug, un manque, une idée ? Écris-le ici, ça m'arrive directement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不具合、足りないもの、思いついたこと。ここに書いてもらえれば直接届きます。"
          }
        }
      }
    },
