    "Nothing to restore on this Apple Account. Tips carry over through iCloud — make sure iCloud Drive is on and you're signed in with the same account." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Apple-Account gibt es nichts wiederherzustellen. Trinkgelder werden über iCloud übertragen — prüfe, ob iCloud Drive an ist und du mit demselben Account angemeldet bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing to restore on this Apple Account. Tips carry over through iCloud — make sure iCloud Drive is on and you're signed in with the same account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay nada que restaurar en esta cuenta de Apple. Las propinas se transfieren por iCloud: comprueba que iCloud Drive esté activado y que uses la misma cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à restaurer sur ce compte Apple. Les pourboires sont transférés via iCloud — vérifie qu'iCloud Drive est activé et que tu utilises le même compte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このApple Accountに復元できる購入はありません。チップはiCloud経由で引き継がれます。iCloud Driveがオンで、同じアカウントでサインインしているか確認してください。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Apple Hesabında geri yüklenecek bir şey yok. Bahşişler iCloud üzerinden taşınır — iCloud Drive'ın açık ve aynı hesapla giriş yapmış olduğundan emin ol."
          }
        }
      }
    },
