    "Premium removes every ad forever, hands you an extra life each endless run, 8 exclusive themes and your own photo in the orb." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium entfernt jede Werbung für immer: ein Extraleben pro Endlos-Runde, 8 exklusive Designs und dein eigenes Foto in der Kugel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium removes every ad forever, hands you an extra life each endless run, 8 exclusive themes and your own photo in the orb."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium elimina todos los anuncios para siempre: una vida extra en cada partida infinita, 8 temas exclusivos y tu propia foto en la esfera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium supprime toutes les pubs pour de bon : une vie supplémentaire à chaque partie infinie, 8 thèmes exclusifs et ta photo dans la sphère."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレミアムなら広告を永久に非表示。エンドレスごとに残機1、限定テーマ8種、オーブに自分の写真も。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium bütün reklamları temelli kaldırır: her sonsuz turda bir can hakkı, 8 özel tema ve kürenin içinde kendi fotoğrafın."
          }
        }
      }
    },
