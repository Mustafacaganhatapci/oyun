    "Premium unlocks by itself when you get there. Nothing is spent — every star stays yours." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium schaltet sich von selbst frei, sobald du dort bist. Es wird nichts abgezogen — jeder Stern bleibt dir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium se desbloquea solo cuando llegues. No se gasta nada: todas tus estrellas siguen siendo tuyas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium se débloque tout seul une fois arrivé. Rien n'est dépensé : chaque étoile reste la tienne."
