<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud anahtar-değer deposu.
	     ProgressStore ilerlemeyi NSUbiquitousKeyValueStore ile eşitliyor ama bu
	     yetki olmadan iOS depoyu hiç açmıyor ("Unable to find entitlement for
	     KVS store") ve senkronizasyon sessizce çalışmıyordu. Değer, Apple'ın
	     beklediği <TeamID>.<BundleID> biçimini derleme sırasında üretir. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>

	<!-- Uzaktan bildirim yetkisi.
	     Bu satır olmadan `registerForRemoteNotifications()` sessizce
	     başarısız oluyor ("no valid aps-environment entitlement string
	     found"), yani APNs belirteci hiç gelmiyor ve konu aboneliği hiç
	     kurulmuyor — hata da vermiyor, bildirim de gelmiyor.

	     Değer `development` yazıyor ve öyle KALMALI: App Store'a
	     dağıtım için dışa aktarırken Xcode bunu `production` olarak
	     yeniden imzalıyor. Tek bir .p8 anahtarının hem TestFlight'ta
	     hem yayında çalışmasının sebebi bu. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
