<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Premium oyuncunun kendi efekt seslerini kaydetmesi için; kayıtlar
         cihazdan çıkmaz. Mikrofonu olmayan cihazlarda da kurulabilsin. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- AdMob'un reklam kimliğini okuyabilmesi için (Play politikası gereği beyan edilir) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <!-- Google Play Faturalandırma -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- Bildirim izni Android 13 (33) ile geldi. Ayarlardaki anahtar açılınca
         isteniyor, AÇILIŞTA DEĞİL: ilk açılışta sorulan izin çoğunlukla
         reddediliyor ve bir daha sorulamıyor. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Orbeon">

        <!-- Android 16 (API 36) hedeflenince sw600dp ve üstü ekranlarda
             screenOrientation YOK SAYILIYOR: tablet ve açık katlanabilirde
             oyun yatay açılırdı. Motor x'i genişliğe, y'yi yüksekliğe
             ölçeklediği (halka yarıçapı da genişliğe bağlı) için yatay
             tuvalde halkalar devleşip üst üste biner — oyun oynanmaz hale
             gelir.

             Bu, Google'ın resmi çıkış yolu ve GEÇİCİ: API 37 hedeflendiğinde
             artık işe yaramayacak. Kalıcı çözüm tuvali dikey orana sabitleyip
             geniş ekranda ortalamak (mektup kutusu), tıpkı
             playable/orbeon-playable.html'de yapıldığı gibi. -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Orbeon">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AdMob uygulama kimliği; derleme türüne göre build.gradle.kts'ten gelir.
             iOS ve Android AdMob'da AYRI uygulamalardır, kimlikleri farklıdır. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

    </application>
</manifest>
