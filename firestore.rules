// Orbeon — Firestore güvenlik kuralları
//
// Firebase Console → Firestore Database → Rules → yapıştır → PUBLISH.
// Yayınlandığını Rules sekmesinin üstündeki "Last published" tarihinden
// doğrula; yayınlanma birkaç saniye sürebiliyor.
//
// Bilerek sade tutuldu. Sıralama tablosunda korunacak bir sır yok: tablo zaten
// herkese açık, yazan taraf da anonim de olsa kimliği doğrulanmış bir oturum.
// Kuralın anlaşılır olması, kılı kırk yarmasından daha değerli.
//
// Tek istisna promosyon kodları. Onlar da istemciden okunmak zorunda (kodu
// doğrulayan uygulamanın kendisi), ama LİSTELENEBİLİR olmamalı: kimliğini
// bildiğin tek bir kodu sorabilirsin, koleksiyonun tamamını çekemezsin.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Premium kodları. `get` açık — uygulama girilen kodu böyle doğruluyor.
    // `list` KAPALI: aksi hâlde meraklı biri bütün kodları tek istekte
    // indirip kendine premium açardı.
    //
    // Güncelleme yalnızca sayacı ilerletmek için; kodun kendisini (active,
    // maxUses) istemci değiştiremez, onları konsoldan sen yönetirsin.
    match /promoCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create, delete: if false;
      //
      // Alanlara `get` ile erişilir: `active` ya da `maxUses` yazılmamış bir
      // belgede doğrudan erişim kuralı hataya düşürüp kodu reddediyordu.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['uses', 'redeemedBy', 'lastRedeemedAt'])
        && request.resource.data.get('active', true) == resource.data.get('active', true)
        && request.resource.data.get('maxUses', 0) == resource.data.get('maxUses', 0);
    }

    // Destekçi kaydı: kim ne aldı. Sonradan hediye premium/kod gönderebilmek
    // için tutuluyor. Oyuncu adları ve satın alma geçmişi içerdiği için
    // istemciye OKUMA KAPALI — yalnızca Firebase konsolundan görülür.
    // Yazma yalnızca kişinin kendi belgesine.
    match /supporters/{playerID} {
      allow read: if false;
      allow write: if request.auth != null;
    }

    // Ayar belgeleri (sıralama doldurmaları vb.). Uygulama okur, yalnızca
    // konsoldan değiştirilir.
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Oyuncuların ayarlardan yazdığı görüş ve öneriler.
    // Yalnızca YAZILIR: istemci ne okuyabilir ne değiştirebilir; başkalarının
    // yazdıklarını görmek kimsenin işi değil.
    match /feedback/{doc} {
      allow read, update, delete: if false;
      allow create: if request.auth != null
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000;
    }

    // Kalan her şey (haftalık sıralama tabloları ve `usernames`):
    //   • okuma herkese açık — tablo zaten kamuya görünür
    //   • yazma yalnızca oturum açmış istemcilere (uygulama anonim giriş yapar)
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
