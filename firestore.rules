// Orbeon — Firestore güvenlik kuralları
//
// Firebase Console → Firestore Database → Rules → yapıştır → PUBLISH.
// Yayınlandığını Rules sekmesinin üstündeki "Last published" tarihinden
// doğrula; yayınlanma birkaç saniye sürebiliyor.
//
// Bilerek sade tutuldu. Önceki sürüm koleksiyon adını düzenli ifadeyle
// süzüyordu ve sahada hem okuma hem yazma "Missing or insufficient
// permissions" ile reddedildi. Sıralama tablosunda korunacak bir sır yok:
// tablo zaten herkese açık, yazan taraf da anonim de olsa kimliği doğrulanmış
// bir oturum. Kuralın anlaşılır olması, kılı kırk yarmasından daha değerli.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Tüm koleksiyonlar (haftalık sıralama tabloları ve `usernames`):
    //   • okuma herkese açık — tablo zaten kamuya görünür
    //   • yazma yalnızca oturum açmış istemcilere (uygulama anonim giriş yapar)
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
